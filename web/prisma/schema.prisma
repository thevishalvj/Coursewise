// Coursewise app data, stored in Supabase Postgres.
// Apply with: npx prisma db push   (see web/README.md)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One row per Supabase Auth user. `id` is the Supabase user id (auth.users.id).
model User {
  id            String         @id @db.Uuid
  email         String         @unique
  createdAt     DateTime       @default(now())
  conversations Conversation[]
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @default("New chat")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([userId, updatedAt])
}

enum Role {
  user
  assistant
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           Role
  content        String
  /// Agent route for assistant messages: course_info, grading, compare, off_topic.
  route          String?
  /// Sources returned by the AI service, as JSON.
  sources        Json?
  latencyMs      Int?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}
