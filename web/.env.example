# Copy to web/.env.local and fill in. Never commit it.
# Supabase dashboard: Project Settings > API (URL and publishable key)
NEXT_PUBLIC_SUPABASE_URL=https://qoasxikrosucaqfsobhe.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase dashboard: Connect button > ORMs > Prisma.
# Pooled connection (port 6543), used by the running app:
DATABASE_URL="postgresql://postgres.qoasxikrosucaqfsobhe:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct/session connection (port 5432), used by `npx prisma db push`:
DIRECT_URL="postgresql://postgres.qoasxikrosucaqfsobhe:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# The FastAPI service from ai/
AI_SERVICE_URL=http://localhost:8000
